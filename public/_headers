# Cloudflare Pages headers. Built JS/CSS have content hashes in their names: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data URLs carry ?v=<build id> (src/cache-bust.js), so each deploy gets fresh files; still revalidate.
/data/*
  Cache-Control: public, max-age=3600, must-revalidate
/cities/*
  Cache-Control: public, max-age=3600, must-revalidate
/models/*
  Cache-Control: public, max-age=86400
